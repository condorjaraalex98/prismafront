{
  "expo": {
    "name": "Prisma Ops",
    "slug": "Pris",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icono.png",
    "scheme": "pris",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.condorj.prismaops",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Permitir el reconocimiento de voz para transcribir los detalles.",
        "NSMicrophoneUsageDescription": "Permitir que la aplicación acceda al micrófono para dictar los reportes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icono.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.condorj.prismaops",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/iconoweb.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permitir que la aplicación acceda al micrófono para dictar los reportes.",
          "speechRecognitionPermission": "Permitir el reconocimiento de voz para transcribir los detalles."
        }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "54ce9b61-72e9-472f-9e28-0db783a39614"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/54ce9b61-72e9-472f-9e28-0db783a39614"
    }
  }
}
